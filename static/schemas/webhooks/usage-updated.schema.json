{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://docs.bsptest.com/schemas/webhooks/usage.updated.schema.json",
  "title": "usage.updated",
  "type": "object",
  "required": [
    "id",
    "type",
    "api_version",
    "created_at",
    "account_id",
    "project_id",
    "data"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^evt_"
    },
    "type": {
      "const": "usage.updated"
    },
    "api_version": {
      "type": "string"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "account_id": {
      "type": "string"
    },
    "project_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "data": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
